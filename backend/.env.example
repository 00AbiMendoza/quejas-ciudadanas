# ─────────────────────────────────────────────────────────────
#  Copia este archivo como ".env" (en esta misma carpeta backend/)
#  y completa los valores. NUNCA subas .env ni la clave .json a GitHub.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor (Portal: http://localhost:3000  ·  Panel: http://localhost:3000/admin)
PORT=3000

# ── Firebase ────────────────────────────────────────────────
# Ruta al archivo JSON de la cuenta de servicio (relativa a la carpeta backend/).
# Consola de Firebase → ⚙ Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternativa para hosting (Render, Railway…): pega TODO el contenido del JSON en una sola línea.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Solo para desarrollo con el emulador local de Firestore (ver README):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-quejas

# ── Acceso al Panel de Administración ──────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=Municipal2026!
ADMIN_NAME=Administrador municipal

# Clave para firmar los tokens de sesión (JWT). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# ── Otros ───────────────────────────────────────────────────
# Tamaño máximo de la foto que sube el ciudadano (MB). El backend la comprime antes de guardarla.
MAX_FOTO_MB=5

# Solo si el frontend se publica en OTRO dominio (p. ej. Live Server en el puerto 5500):
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Si despliegas detrás de un proxy (Render/Railway), usa 1
# TRUST_PROXY=1
